{
  "name": "dsh-mistake-book",
  "version": "0.57.0",
  "type": "module",
  "description": "错题本 DSH 插件：13 个模型工具（复习 / 检索 / 录入 / 判分 / 统计 / 断点 / 事件 / 批量导入 / 组卷 / 周报 / 知识库整理）+ 两条预设 + 侧栏面板（六页签）",
  "icon": "./icon.png",
  "exports": {
    ".": "./lib/plugin.js",
    "./tools": "./lib/tools.js",
    "./api": "./lib/api.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "icon.png",
    "install.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mistake-book",
    "fsrs",
    "spaced-repetition",
    "study"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SHW-bit/mistake-book.git"
  },
  "bugs": {
    "url": "https://github.com/SHW-bit/mistake-book/issues"
  },
  "homepage": "https://github.com/SHW-bit/mistake-book#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  }
}
